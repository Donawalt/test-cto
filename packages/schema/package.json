{
  "name": "@myapp/schema",
  "version": "1.0.0",
  "description": "JSON schema builder and code generation CLI",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "schema": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly && chmod +x dist/cli.js",
    "type-check": "tsc --noEmit",
    "generate": "tsx src/cli.ts generate",
    "generate:watch": "tsx src/cli.ts generate --watch",
    "migrate:create": "tsx src/cli.ts migrate:create --name",
    "migrate:run": "tsx src/cli.ts migrate:run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@myapp/types": "workspace:*",
    "chokidar": "^3.5.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.11"
  }
}
