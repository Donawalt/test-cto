# Sanity CMS Configuration
# Copy this file to .env and fill in your values

# Sanity Project ID (get from sanity.io manage)
SANITY_STUDIO_PROJECT_ID=your-project-id

# Dataset name (defaults to 'production')
SANITY_STUDIO_DATASET=production

# API Version (ISO date, defaults to current date)
SANITY_API_VERSION=2024-01-01

# CORS origins (for frontend access)
# Add your frontend URLs here, separated by commas
SANITY_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
