{
  "name": "astro",
  "description": "Static site generator with Astro, React, Tailwind CSS, and optional SSR",
  "type": "frontend",
  "framework": "astro",
  "setupTime": "2 minutes",
  "monorepoReady": true,
  "standaloneReady": true,
  "features": [
    "Astro 4.x with React",
    "Static Site Generation (SSG)",
    "Tailwind CSS styling",
    "Optional SSR mode",
    "File-based routing",
    "Component islands",
    "TypeScript support",
    "Vitest testing"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest"
  },
  "dependencies": {
    "astro": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@astrojs/react": "^3.0.0",
    "@astrojs/tailwind": "^5.0.0",
    "@types/react": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "astro",
    "react",
    "static-site",
    "typescript",
    "tailwind"
  ],
  "author": "test-cto",
  "version": "1.0.0"
}
