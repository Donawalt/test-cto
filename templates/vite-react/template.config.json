{
  "name": "vite-react",
  "description": "Modern React SPA with Vite, TanStack Router, Tailwind CSS, and Lenis smooth scrolling",
  "type": "frontend",
  "framework": "react",
  "setupTime": "2 minutes",
  "monorepoReady": true,
  "standaloneReady": true,
  "features": [
    "React 18 with Vite",
    "TanStack Router for type-safe routing",
    "Tailwind CSS styling",
    "Lenis smooth scrolling",
    "TanStack Query for data fetching",
    "Vitest testing setup",
    "TypeScript strict mode",
    "ESLint + Prettier"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "tailwindcss": "^3.4.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "react",
    "vite",
    "typescript",
    "tailwind",
    "router",
    "SPA"
  ],
  "author": "test-cto",
  "version": "1.0.0"
}
