{
  "name": "api-server",
  "description": "Express API server with Drizzle ORM, Zod validation, JWT auth, and Docker support",
  "type": "backend",
  "framework": "express",
  "setupTime": "2 minutes",
  "monorepoReady": true,
  "standaloneReady": true,
  "features": [
    "Express.js backend",
    "Drizzle ORM database",
    "Zod input validation",
    "JWT authentication",
    "Role-based authorization",
    "Rate limiting",
    "Helmet security headers",
    "Docker + docker-compose",
    "Vitest testing",
    "TypeScript strict mode"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "express": "^4.18.0",
    "drizzle-orm": "^0.29.0",
    "zod": "^3.22.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.10.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/cors": "^2.8.0",
    "typescript": "^5.3.0",
    "tsx": "^4.6.0",
    "vitest": "^1.0.0",
    "drizzle-kit": "^0.20.0"
  },
  "keywords": [
    "express",
    "api",
    "typescript",
    "drizzle",
    "orm",
    "backend"
  ],
  "author": "test-cto",
  "version": "1.0.0"
}
