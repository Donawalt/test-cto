{
  "name": "myapp-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready monorepo with automatic type generation, comprehensive tooling, and 6 ready-to-use templates",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "pnpm types:generate && turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@myapp/web",
    "dev:server": "turbo run dev --filter=@myapp/server",
    "build": "pnpm types:generate && turbo run build",
    "build:web": "turbo run build --filter=@myapp/web",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo run test",
    "types:generate": "turbo run generate --filter @myapp/schema -- --output ../types/src/generated",
    "types:watch": "turbo run generate:watch --filter @myapp/schema -- --output ../types/src/generated",
    "types:check": "turbo run type-check",
    "dev:watch": "concurrently \"pnpm types:watch\" \"turbo run dev --parallel\"",
    "schema:generate": "pnpm --filter=@myapp/schema generate",
    "migrate:create": "pnpm --filter=@myapp/schema migrate:create",
    "migrate:run": "pnpm --filter=@myapp/schema migrate:run",
    "clean": "turbo run clean && rm -rf packages/types/src/generated",
    "docs": "echo 'API documentation generation coming soon'",
    "create-from-template": "bash scripts/create-from-template.sh",
    "create-template": "bash scripts/create-from-template.sh"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.4",
    "tsx": "^4.7.0",
    "turbo": "^1.11.3",
    "typescript": "^5.3.3"
  }
}
